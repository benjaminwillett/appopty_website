# /etc/systemd/system/appopty-site.service  (Linux)
[Unit]
Description=Appopty website (waitress)
After=network-online.target
Wants=network-online.target

[Service]
User=appopty
Group=appopty
WorkingDirectory=/opt/appopty-site/current
EnvironmentFile=/etc/appopty-site/site.env
# waitress drops X-Forwarded-* from untrusted peers: without the --trusted-proxy flags the
# site never sees HTTPS (no HSTS) and every visitor shares one rate limit. One process only:
# the rate limit is held in memory.
ExecStart=/opt/appopty-site/venv/bin/waitress-serve --listen=127.0.0.1:8080 --threads=8 --ident=appopty \
    --trusted-proxy=127.0.0.1 --trusted-proxy-headers="x-forwarded-for x-forwarded-proto x-forwarded-host" \
    --clear-untrusted-proxy-headers wsgi:app
Restart=on-failure
RestartSec=3
# Hardening: the site only reads its own files.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadOnlyPaths=/opt/appopty-site
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
